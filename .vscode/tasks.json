{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: dotnet run (SQL Express)",
      "type": "shell",
      "command": "dotnet run --project ./backend/TaskManagerApi.csproj",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
